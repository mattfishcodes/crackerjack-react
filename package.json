{
  "name": "crackerjack-react",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "github",
    "url": "https://github.com/nuggsrocks/crackerjack-react"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm copy-consent && next build",
    "start": "next start",
    "lint": "eslint .",
    "stylelint": "stylelint ./src/**/*.css --fix",
    "prettier": "prettier . --write",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "cleanup": "npm run lint && npm run typecheck && npm run prettier",
    "optimize-images": "node scripts/optimize-images.js",
    "copy-consent": "node scripts/copy-consent.js"
  },
  "dependencies": {
    "@next/third-parties": "^16.1.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/postcss": "^4.1.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-consent": "https://github.com/nuggsrocks/cookie-consent#v1.2.3",
    "lucide-react": "^0.562.0",
    "next": "^16.1.6",
    "postcss": "^8.5.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "schema-dts": "^1.1.5",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.1.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.1.6",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "image-tools": "https://github.com/nuggsrocks/image-tools#v1.1.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.28.2"
}
