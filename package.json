{
  "name": "crackerjack-react",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "next dev",
    "build": "rm -rf out && next build",
    "start": "next start",
    "lint": "eslint .",
    "prettier": "prettier . --write",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "cleanup": "npm run lint && npm run typecheck && npm run prettier",
    "sharp": "rm public/images/*.webp; node scripts/optimize-images.js"
  },
  "dependencies": {
    "@next/third-parties": "^16.1.0",
    "lucide-react": "^0.562.0",
    "next": "^16.1.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sass": "^1.94.2"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.1.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.1.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "sass-loader": "^16.0.6",
    "typescript": "^5"
  }
}
